<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_gradient_main"
    tools:context=".ForgotPasswordActivity">

    <TextView
        android:id="@+id/btnCloseForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="22sp"
        android:textColor="@color/text_primary"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your email. We'll send you a reset code."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <!-- Step 1: Email -->
    <LinearLayout
        android:id="@+id/step1Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etForgotEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSendCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Reset Code"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Step 2: Code + New Password -->
    <LinearLayout
        android:id="@+id/step2Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Code"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/etResetCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste the code from your email"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="At least 6 characters"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConfirmReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:backgroundTint="@color/accent_success"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>